# ==============================================================================
# Smart Real-Time Project Team Finder System - Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=False

# JWT & Application Security Key
JWT_SECRET=supersecret_college_portal_jwt_token_key_2026!

# Database Configuration
# Supported DB_TYPE values:
#   - "mysql"  : Connects to MySQL using PyMySQL (recommended for production)
#   - "sqlite" : Uses local SQLite file (fallback for standalone testing)
DB_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=college_portal
DB_FILE=portal.sqlite

# Institutional Domain Governance
FACULTY_EMAIL_DOMAIN=@college.edu
